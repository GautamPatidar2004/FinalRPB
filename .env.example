# ====================================================================
# Railway Block Planning Engine - Environment Configuration Template
# Copy this file to .env and configure your local development values.
# DO NOT commit real API secrets or credentials to source control.
# ====================================================================

# Service Configuration
ENVIRONMENT=development
SERVICE_NAME=railway-planning-ai
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Supabase Credentials (Optional for local development; in-memory fallback is used if omitted)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AI Model Configuration (relative to service root or absolute path)
MODEL_ARTIFACT_PATH=models/artifacts/priority_model.joblib
TRAINING_CSV_PATH=data/training/historical_maintenance.csv
